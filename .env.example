# Konfigurasi Supabase untuk Buktip
# Salin file ini menjadi .env.local dan isi dengan nilai kredensial dari dashboard Supabase Anda.
# Jangan pernah membagikan atau commit file .env.local ke repositori publik.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
